---
/** Social platform glyphs for the footer row.
 *
 *  Inline SVG paths rather than an icon font or sprite: three glyphs don't
 *  justify a network request, and `fill="currentColor"` means the existing
 *  `.foot-social a` hover rule (which swaps the text colour) keeps working
 *  with no extra CSS.
 *
 *  These are concept builds — the links intentionally go nowhere (`href="#"`),
 *  since the business doesn't exist and there is no account to point at. The
 *  icons are here so the footer reads like a real one.
 */
interface Props {
  /** Platform name — also used for the accessible label.
   *
   *  Yelp is deliberately absent. Its burst mark is five separate asymmetric
   *  shapes and two hand-drawn attempts both rendered as a symmetric pinwheel,
   *  which reads as a *different company's* logo rather than an approximation.
   *  A wrong logo is worse than no logo; the restaurants use Instagram /
   *  Facebook / TikTok instead, which is what they'd actually lead with.
   */
  name:
    | "Instagram"
    | "Facebook"
    | "TikTok"
    | "YouTube"
    | "Discord"
    | "Pinterest"
    | "X";
  /** Rendered glyph size in px. The circle around it is sized in CSS. */
  size?: number;
}

const { name, size = 16 } = Astro.props;

