---
/** Google Maps embed beside the contact details. Home + Contact.
 *  Keyless embed form (`?q=...&output=embed`) — no Maps API key required. */
const address = "61287 S Hwy 97, Suite 4, Bend, OR 97702";
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&z=11&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<section class="section contact" id="contact">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Where we work</p>
      <h2>Serving central Oregon within 20 miles of Bend.</h2>
      <p>Bend · Redmond · Sisters · Tumalo · Sunriver</p>
    </div>
    <div class="contact-grid">
      <div class="map-box">
        <iframe
          class="map-frame"
          src={mapSrc}
          title="Map of the Cedar & Stone office in Bend, Oregon"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
        <a
          class="maplbl"
          href={mapLink}
          target="_blank"
          rel="noopener noreferrer">Open in Google Maps</a
        >
      </div>
      <div class="contact-card">
        <h3>Stop by or give us a call</h3>
        <div class="contact-row">
          <div class="k">Office</div>
          <div class="v">61287 S Hwy 97, Suite 4<br />Bend, OR 97702</div>
        </div>
        <div class="contact-row">
          <div class="k">Phone</div>
          <div class="v"><a href="tel:+15415550148">(541) 555-0148</a></div>
        </div>
        <div class="contact-row">
          <div class="k">Email</div>
          <div class="v">
            <a href="mailto:hello@cedarandstone.co">hello@cedarandstone.co</a>
          </div>
        </div>
        <div class="contact-row">
          <div class="k">Hours</div>
          <div class="v">
            Mon–Fri · 7am – 5pm<br />Sat · by appointment<br />Sun · closed
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
