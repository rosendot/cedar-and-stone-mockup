---
/** Service-area map (CSS-drawn, no Maps embed) beside the contact details.
 *  Home + Contact. */
---

<section class="section contact" id="contact">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Where we work</p>
      <h2>Serving central Oregon within 20 miles of Bend.</h2>
      <p>Bend · Redmond · Sisters · Tumalo · Sunriver</p>
    </div>
    <div class="contact-grid">
      <div class="map-box" aria-label="Service area map">
        <div class="roads">
          <div class="road" style="top:32%; left:0; right:0; height:6px;"></div>
          <div class="road" style="top:0; bottom:0; left:58%; width:6px;"></div>
          <div class="road" style="top:64%; left:0; right:0; height:4px; opacity:.6;"></div>
          <div class="road" style="top:0; bottom:0; left:24%; width:4px; opacity:.6;"></div>
        </div>
        <div class="radius"></div>
        <div class="pin"></div>
        <span class="maplbl">Service area · 20-mile radius of Bend</span>
      </div>
      <div class="contact-card">
        <h3>Stop by or give us a call</h3>
        <div class="contact-row">
          <div class="k">Office</div>
          <div class="v">61287 S Hwy 97, Suite 4<br />Bend, OR 97702</div>
        </div>
        <div class="contact-row">
          <div class="k">Phone</div>
          <div class="v"><a href="tel:+15415550148">(541) 555-0148</a></div>
        </div>
        <div class="contact-row">
          <div class="k">Email</div>
          <div class="v">
            <a href="mailto:hello@cedarandstone.co">hello@cedarandstone.co</a>
          </div>
        </div>
        <div class="contact-row">
          <div class="k">Hours</div>
          <div class="v">
            Mon–Fri · 7am – 5pm<br />Sat · by appointment<br />Sun · closed
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
